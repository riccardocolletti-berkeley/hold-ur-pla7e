<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ball_tracker_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 wrapper around the standalone vision tracker; publishes ball position and velocity in the table frame.</description>
  <maintainer email="riccardo_colletti@berkeley.edu">Riccardo Colletti</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ball_tracker_msgs</depend>

  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- tracker_launch.py loads ball_balance_controller/config/reference.yaml,
       the shared trajectory definition. Pure launch-time data dependency. -->
  <exec_depend>ball_balance_controller</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
