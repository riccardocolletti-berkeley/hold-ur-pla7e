Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /BallBalance Markers1
      Splitter Ratio: 0.55
    Tree Height: 600
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.02
        Value: Lines
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Mass Properties:
        Inertia: false
        Mass: false
      Update Interval: 0
      Value: true

    - Class: rviz_default_plugins/TF
      Name: TF
      All Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.25
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        base_link: { Value: true }
        tool0:     { Value: true }
        plate_center: { Value: true }
      Tree:
        {}
      Update Interval: 0
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Name: BallBalance Markers
      Topic:
        Value: /ball_balance_visualization
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        ball_balance: true
      Value: true

  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.6
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.4
      Pitch: 0.45
      Yaw: 0.9
      Target Frame: base_link
      Value: Orbit (rviz)

Window Geometry:
  Height: 800
  Width: 1280
  Hide Left Dock: false
  Hide Right Dock: true
