<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ball_balance_controller</name>
  <version>0.1.0</version>
  <description>
    Closed-loop ball-on-plate controller for the UR arm. Subscribes to
    /ball_state from the vision tracker, runs a Jacobian-based controller
    using the shared ballplate PID core, and streams single-point joint
    trajectories on /scaled_joint_trajectory_controller/joint_trajectory.
  </description>

  <maintainer email="riccardo_colletti@berkeley.edu">Riccardo Colletti</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>visualization_msgs</depend>
  <depend>ball_tracker_msgs</depend>

  <!-- Optional: pulled in by `view.launch.py` and by `balance.launch.py rviz:=true`. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
